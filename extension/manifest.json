{
  "manifest_version": 3,
  "name": "RATNET: Rat King check",
  "short_name": "RATNET",
  "version": "0.1.0",
  "description": "The Rat King's read on every Solana coin you open: bond score, who is really buying (FOMO traders, earners, bots), copies and red flags.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }, "default_title": "Rat King check" },
  "background": { "service_worker": "bg.js" },
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["https://www.ratnet.network/*"],
  "content_scripts": [
    {
      "matches": ["https://pump.fun/*", "https://*.pump.fun/*", "https://gmgn.ai/*", "https://axiom.trade/*", "https://*.axiom.trade/*", "https://neo.bullx.io/*", "https://photon-sol.tinyastro.io/*", "https://dexscreener.com/*", "https://padre.gg/*", "https://trade.padre.gg/*"],
      "js": ["render.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
